# Copy to .env, edit, then load with: set -a; source .env; set +a
# Bifrost OpenAI-compatible base URL. Do not append /chat/completions.
OPENAI_BASE_URL=http://localhost:8080/openai
# Use a model configured in your gateway. Keep the provider prefix when needed.
OPENAI_MODEL=openai/gpt-4o-mini
# Optional: standard Bearer authentication for your gateway.
OPENAI_API_KEY=
# Optional: Bifrost virtual key, sent as x-bf-vk (also supports legacy keys).
BIFROST_VIRTUAL_KEY=
