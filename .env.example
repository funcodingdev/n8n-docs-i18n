# Copy to .env, edit, then load with: set -a; source .env; set +a
# Your OpenAI-compatible gateway base URL. Do not append /chat/completions.
OPENAI_BASE_URL=https://api.flowist.dev/v1
# Use a model configured in your gateway. Keep the provider prefix when needed.
OPENAI_MODEL=sub2apigpt/gpt-6.1-sol
# Optional: standard Bearer authentication for your gateway.
OPENAI_API_KEY=
